{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=market.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_USE_USER_SECRETS_MIN_32_CHARS",
    "Issuer": "BackendMarket",
    "Audience": "BackendMarketUsers",
    "ExpiresInMinutes": 120
  }
}
